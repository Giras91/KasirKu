<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvKitchenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen Printer Setup"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbEnableKitchen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Kitchen Printer"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kitchen Printer Type:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgKitchenType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbKitchenNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Printer"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbKitchenUSB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB Printer" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="IP Address:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKitchenIP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="192.168.1.101"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Port:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etKitchenPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="9100"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnTestKitchen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test Kitchen Printer"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSaveKitchen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Kitchen Settings" />

    </LinearLayout>

</ScrollView>