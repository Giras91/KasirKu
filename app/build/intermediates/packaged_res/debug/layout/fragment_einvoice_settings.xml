<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvEInvoiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Malaysian E-Invoice Setup"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbEnableEInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable E-Invoice"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TIN (Tax Identification Number):"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTIN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter TIN"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BRN (Business Registration Number):"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etBRN"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter BRN"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SST Number:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSSTNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter SST Number (optional)"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Settings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Client ID:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etClientID"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Client ID"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Client Secret:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etClientSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Client Secret"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveEInvoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save E-Invoice Settings" />

    </LinearLayout>

</ScrollView>