<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrinterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Printer Selection"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Printer Library:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPrinterLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbEscPosCoffee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESC/POS Coffee (Legacy)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbThermalPrinter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thermal Printer (Recommended)" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Printer Type:"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPrinterType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbUSB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB Printer"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Printer" />

            <RadioButton
                android:id="@+id/rbBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth Printer" />

        </RadioGroup>

        <!-- Network Printer Settings -->
        <LinearLayout
            android:id="@+id/llNetworkSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network Printer Settings:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IP Address:"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNetworkIP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="192.168.1.100"
                android:inputType="textNoSuggestions"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Port:"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNetworkPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="9100"
                android:inputType="number"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Bluetooth Printer Settings -->
        <LinearLayout
            android:id="@+id/llBluetoothSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bluetooth Printer Settings:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Device:"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spBluetoothDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnScanBluetooth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan Devices"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnTestPrint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test Print"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Settings"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>