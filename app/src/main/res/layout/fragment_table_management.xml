<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTableTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Table Management"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnManageTables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Tables"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure table layout, seating capacity, and table status management for your restaurant."
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>